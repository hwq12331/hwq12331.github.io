---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile, route } from '../data/profile';
import '../styles/global.css';

interface Props { title?: string; description?: string; article?: boolean; published?: Date; }
const {
  title = 'Hussain Alqassab — Business, technology & the ideas in between',
  description = 'The portfolio and journal of Hussain Alqassab: KFUPM MIS graduate building digital business workflows, financial-analytics tools and bilingual applications.',
  article = false,
  published,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(route('images/social-card.png'), Astro.site);
const schema = article ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title,
  description, datePublished: published?.toISOString(), mainEntityOfPage: canonical.href,
  author: { '@type': 'Person', name: profile.name, url: Astro.site?.href }, image: image.href,
} : {
  '@context': 'https://schema.org', '@type': 'Person', name: profile.name,
  url: Astro.site?.href, description, image: new URL(route('images/hussain-portrait.webp'), Astro.site).href,
  sameAs: [profile.github, profile.linkedin],
  alumniOf: { '@type': 'CollegeOrUniversity', name: profile.university },
  address: { '@type': 'PostalAddress', addressLocality: 'Dammam', addressCountry: 'SA' },
};
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f6f2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={route('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="Hussain Alqassab — Journal" href={route('rss.xml')} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Hussain Alqassab" />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Newsreader:ital,wght@0,400;0,500;1,400;1,500&display=swap" rel="stylesheet" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('hussain-theme') || 'light'; } catch { }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <div class="toast" id="site-toast" role="status" aria-live="polite"></div>
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
