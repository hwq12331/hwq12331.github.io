---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import JournalGrid from '../components/JournalGrid.astro';
import Contact from '../components/Contact.astro';
import { additionalProjects, coursework, links, profile, route, skillGroups } from '../data/profile';
const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout>
  <section class="hero container">
    <div class="hero-copy" data-reveal><div class="intro-label"><span class="status-dot"></span>BUSINESS-MINDED. TECHNOLOGY-DRIVEN.</div><h1>Hussain<br /><em>Alqassab.</em><span class="hero-title-dot"></span></h1><p class="hero-description">Turning business needs into <strong>practical digital systems</strong>, thoughtful interfaces, and data-led research.</p><div class="hero-qualification"><span>KFUPM</span>Management Information Systems graduate</div><div class="hero-actions"><a class="button button-primary" href="#work">Explore my work <Icon name="arrow" /></a><a class="button button-secondary" href={route('resume/Hussain_Alqassab_CV.pdf')} download>Download CV <Icon name="download" size={18} /></a></div><div class="hero-socials"><a href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18} />GitHub<Icon name="external" size={14} /></a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={18} />LinkedIn<Icon name="external" size={14} /></a><span class="hero-location"><Icon name="location" size={16} />Dammam, Saudi Arabia</span></div></div>
    <div class="hero-visual" data-reveal><div class="portrait-grid"></div><div class="portrait-orbit"></div><div class="hello-note">Hello, I’m Hussain.<span lang="ar" dir="rtl">أهلاً وسهلاً</span></div><div class="portrait-frame"><img src={route('images/hussain-portrait.webp')} width="495" height="640" alt="Portrait of Hussain Alqassab" fetchpriority="high" /><div class="portrait-caption"><span>HUSSAIN ALQASSAB</span><span>Ideas → Systems → Insight</span></div></div><div class="floating-note"><span class="floating-icon"><Icon name="workflow" size={22} /></span><div><strong>Business × technology</strong><span>Built to be useful.</span></div></div><span class="portrait-coordinate">2026 / DAMMAM / SA</span><svg class="hero-spark" viewBox="0 0 80 80" aria-hidden="true"><path d="M40 0v80M0 40h80M12 12l56 56M12 68l56-56" stroke="currentColor" stroke-width="2" /></svg></div>
  </section>
  <div class="container focus-strip"><a href="#experience"><span>01</span>Digital business workflows<Icon name="workflow" /></a><a href="#work"><span>02</span>Financial data & research<Icon name="chart" /></a><a href="#work"><span>03</span>Bilingual interfaces<Icon name="globe" /></a></div>

  <section class="section container about-grid" id="about">
    <div data-reveal><span class="eyebrow"><span></span>A LITTLE ABOUT ME</span><h2>Business thinking.<br /><em>Hands-on building.</em></h2><p class="section-lead">I’m an MIS graduate from KFUPM with experience in digital transformation, application development, and financial-data research.</p><p>I enjoy the space where business requirements meet software: understanding a workflow, modeling the data behind it, and building an interface that makes it easier to use.</p><p>My work spans company operations at Al Manaseeb Contracting Company, Python stock-analysis pipelines, and Arabic-first application prototypes. This site brings those projects—and the ideas behind them—together.</p><div class="about-values"><span><Icon name="check" size={16} />Clear requirements</span><span><Icon name="check" size={16} />Practical execution</span><span><Icon name="check" size={16} />Careful validation</span></div></div>
    <aside class="education-card" data-reveal><div class="education-heading"><span class="education-icon"><Icon name="book" size={25} /></span><span class="small-label">EDUCATION & BACKGROUND</span></div><div class="university-monogram">KFUPM<span>MIS / CLASS OF 2025</span></div><h3>{profile.degree}</h3><p>{profile.university}<br />Dhahran, Saudi Arabia</p><div class="education-date"><span>Graduated</span><strong>{profile.graduation}</strong></div><details class="coursework"><summary>Selected coursework <span>+</span></summary><ul>{coursework.map(course => <li>{course}</li>)}</ul></details><div class="language-row"><span class="small-label">LANGUAGES</span>{profile.languages.map(language => <span>{language}</span>)}</div></aside>
  </section>

  <section class="experience-section" id="experience"><div class="container"><div class="section-heading" data-reveal><div><span class="eyebrow light-eyebrow"><span></span>PROFESSIONAL EXPERIENCE</span><h2>Turning requirements<br />into <em>working systems.</em></h2></div><p>Company work that connects technical implementation with day-to-day business operations.</p></div><div class="experience-layout"><div class="experience-summary" data-reveal><div class="experience-time"><span class="timeline-dot"></span>JUN 2024 — JAN 2025</div><h3>Digital Transformation<br />Intern</h3><p class="company-name">Al Manaseeb<br />Contracting Company</p><span class="experience-country"><Icon name="location" size={15} />Saudi Arabia</span><ul class="experience-points"><li>Analyzed industrial-project requirements and supported procurement digitization.</li><li>Prepared quotations, delivery schedules and work breakdown structures for Furnace Camera Replacement and SAPIN proposals.</li><li>Supported risk assessments and HSE documentation, using AI-assisted tools for software prototyping.</li></ul></div><article class="amc-card" data-reveal><div class="amc-window"><div class="window-chrome"><span class="window-dots"><i></i><i></i><i></i></span><span>AMC PROJECT HUB</span><span class="window-status">LIVE DEMO</span></div><img src={route('images/amc-project-hub.webp')} width="1200" height="794" alt="AMC Project Hub sample-data dashboard with projects, procurement and QA summaries" loading="lazy" /></div><div class="amc-card-body"><span class="small-label">BUILT FOR AL MANASEEB CONTRACTING COMPANY</span><h3>AMC Project Hub</h3><p>A connected workspace spanning seven modules: dashboard, projects, procurement, HR, QA/QC, clients, and gate passes.</p><div class="amc-feature-row"><span>Purchase-order line items</span><span>Project progress</span><span>QA checklists</span><span>Gate-pass records</span></div><div class="tech-tags"><span>React</span><span>TypeScript</span><span>Supabase</span><span>PostgreSQL</span></div><div class="card-link-row"><a href={links.amcDemo} target="_blank" rel="noopener noreferrer">Try the demo <Icon name="external" size={17} /></a><a href={links.amc} target="_blank" rel="noopener noreferrer"><Icon name="github" size={17} />Source code</a></div><p class="demo-caption">The public portfolio demo uses sample data and resets on refresh.</p></div></article></div></div></section>

  <section class="section container" id="work"><div class="section-heading" data-reveal><div><span class="eyebrow"><span></span>SELECTED PROJECTS</span><h2>Built with curiosity.<br /><em>Grounded in practice.</em></h2></div><p>Independent work exploring data, software, and the way people interact with technology.</p></div><div class="featured-projects"><article class="project-card stocks-card" data-reveal><div class="stock-preview"><div class="stock-preview-header"><span><span class="status-dot"></span>RESEARCH WORKSPACE</span><Icon name="chart" size={20} /></div><div class="stock-preview-title">Signal.<br /><em>Validate.</em><br />Understand.</div><div class="validation-timeline"><div><span>01</span><strong>Train</strong></div><div class="embargo-stage"><span>02</span><strong>Embargo</strong></div><div><span>03</span><strong>Evaluate</strong></div></div><div class="stock-preview-stats"><div><strong>5</strong><span>timeframes</span></div><div><strong>7,158</strong><span>acquisition universe</span></div><div><strong>4,000</strong><span>research rows</span></div></div></div><div class="project-card-body"><div class="project-type"><span>01 / DATA & MACHINE LEARNING</span><span class="project-status">Research project</span></div><h3>Intelligent Stock<br />Rating System</h3><p>Python stock screening across five timeframes, combining SEC EDGAR/XBRL data, DCF/WACC valuation, ROIC and risk analytics.</p><ul class="project-bullets"><li>Ridge/gradient-boosting ensembles with XGBoost and LightGBM support.</li><li>Embargoed walk-forward validation and fold-specific preprocessing.</li><li>A 4,000-row research dataset covering 200 companies and 20 evaluation dates.</li></ul><div class="tech-tags"><span>Python</span><span>pandas</span><span>scikit-learn</span><span>SEC EDGAR</span></div><div class="card-link-row"><a href={links.stocks} target="_blank" rel="noopener noreferrer">Explore the source <Icon name="external" size={17} /></a><a href={route('journal/time-aware-stock-validation/')}>Read the field note <Icon name="arrow" size={16} /></a></div></div></article><article class="project-card sallehni-card" data-reveal><div class="sallehni-preview"><div class="sallehni-preview-copy"><span class="small-label">ARABIC-FIRST / HUMAN-CENTERED</span><span class="sallehni-brand" lang="ar" dir="rtl">صلّحني</span><div class="sallehni-language-tags"><span>العربية</span><span>English</span></div><span class="sallehni-five"><strong>5</strong> vehicle-service screens</span></div><div class="phone-frame"><span class="phone-speaker"></span><img src={route('images/sallehni.webp')} width="430" height="932" alt="Sallehni Arabic-first vehicle-service interface with health overview and service actions" loading="lazy" /></div></div><div class="project-card-body"><div class="project-type"><span>02 / MOBILE & INTERFACES</span><span class="project-status">Interactive prototype</span></div><h3>Sallehni</h3><p>A React Native/Expo prototype for vehicle health, simulated diagnostics, service booking, repair tracking and maintenance history.</p><ul class="project-bullets"><li>Arabic/English interface controls and RTL-aware layouts.</li><li>Hijri/Gregorian calendar toggles and interactive time-slot selection.</li><li>Reusable TypeScript components and shared React Context.</li></ul><div class="tech-tags"><span>React Native</span><span>Expo</span><span>TypeScript</span><span>Localization</span></div><div class="card-link-row"><a href={links.sallehniDemo} target="_blank" rel="noopener noreferrer">Try the demo <Icon name="external" size={17} /></a><a href={links.sallehni} target="_blank" rel="noopener noreferrer"><Icon name="github" size={17} />Source code</a></div><p class="demo-caption">Diagnostics and service records are simulated for the prototype.</p></div></article></div><div class="more-projects-heading"><h3>More things I’ve built</h3><span>A few other experiments & academic projects</span></div><div class="additional-project-grid">{additionalProjects.map(project => <article class="mini-project" data-reveal><div class="mini-project-top"><span class="mini-project-icon"><Icon name={project.icon} size={22} /></span><a href={project.url} target={project.url.startsWith('http') ? '_blank' : undefined} rel={project.url.startsWith('http') ? 'noopener noreferrer' : undefined} aria-label={project.url.startsWith('http') ? `View ${project.name} on GitHub` : `Ask about ${project.name}`}><Icon name="external" size={23} /></a></div><span class="small-label">{project.category}</span><h4>{project.name}</h4><p>{project.description}</p><div class="mini-project-tags">{project.technologies.map(technology => <span>{technology}</span>)}</div></article>)}</div></section>

  <section class="skills-section" id="skills"><div class="container"><div class="section-heading" data-reveal><div><span class="eyebrow"><span></span>MY TOOLKIT</span><h2>The tools behind<br /><em>the work.</em></h2></div><p>A mix of technical skills and business understanding—the two work best together.</p></div><div class="skills-grid">{skillGroups.map(group => <article class="skill-card" data-reveal><div class="skill-card-heading"><Icon name={group.icon} size={21} /><h3>{group.title}</h3></div><div class="skill-pills">{group.items.map(item => <span>{item}</span>)}</div></article>)}</div></div></section>

  <section class="section container journal-section" id="journal"><div class="section-heading" data-reveal><div><span class="eyebrow"><span></span>THE JOURNAL</span><h2>Notes from<br /><em>the building process.</em></h2></div><a class="text-link" href={route('journal/')}>All field notes <Icon name="arrow" size={18} /></a></div><JournalGrid posts={posts} /></section>
  <Contact />
</BaseLayout>
