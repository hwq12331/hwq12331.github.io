---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCover from '../../components/ArticleCover.astro';
import BlogCard from '../../components/BlogCard.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, profile, readingTime, route } from '../../data/profile';

export async function getStaticPaths() {
  const posts = await getCollection('journal', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'journal'>; }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const related = (await getCollection('journal', ({ data, id }) => !data.draft && id !== post.id)).sort((a, b) => a.data.order - b.data.order).slice(0, 2);
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<BaseLayout title={`${post.data.title} — Hussain Alqassab`} description={post.data.description} article published={post.data.published}>
  <article class="article-page container"><a class="back-link" href={route('journal/')}>← Back to the journal</a><header class="article-header"><span class:list={['category-label', `category-${post.data.cover}`]}>{post.data.category}</span><h1>{post.data.title}</h1><p class="article-deck">{post.data.description}</p><div class="article-byline"><img src={route('images/hussain-portrait.webp')} width="44" height="44" alt="" /><div><strong>{profile.name}</strong><span>{formatDate(post.data.published)} <span>·</span> {readingTime(post.body)} min read</span></div><button class="share-button" type="button" data-copy-url={canonical.href}><Icon name="copy" size={17} />Copy article link</button></div></header><ArticleCover kind={post.data.cover} class="article-hero-cover" /><div class="article-reading-layout"><aside class="article-toc"><span class="small-label">IN THIS NOTE</span><nav aria-label="Table of contents">{headings.filter(heading => heading.depth === 2).map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav><a class="article-toc-contact" href={`mailto:${profile.email}?subject=${encodeURIComponent(post.data.title)}`}>Discuss this project<Icon name="external" size={16} /></a></aside><div class="article-prose"><Content /><div class="article-author"><img src={route('images/hussain-portrait.webp')} width="70" height="70" alt="Hussain Alqassab" loading="lazy" /><div><span class="small-label">WRITTEN BY</span><h2>Hussain Alqassab</h2><p>KFUPM MIS graduate exploring business systems, data, and thoughtful interfaces.</p><a href={profile.github} target="_blank" rel="noopener noreferrer">More of my work <Icon name="external" size={15} /></a></div></div></div></div></article><section class="container article-related"><div class="section-heading"><h2>Keep <em>exploring.</em></h2><a class="text-link" href={route('journal/')}>All notes<Icon name="arrow" size={17} /></a></div><div class="blog-grid related-grid">{related.map(entry => <BlogCard post={entry} />)}</div></section>
</BaseLayout>
